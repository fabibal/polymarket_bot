DRY_RUN=true
PORT=8080
LEADERBOARD_REFRESH_MS=300000
POLL_INTERVAL_MS=30000
PRICE_UPDATE_INTERVAL_MS=300000

# Path to your ~/.bullpen directory on the host (mounted into the container)
BULLPEN_CONFIG_PATH=~/.bullpen

# ── WireGuard credentials (consumed by gluetun) ───────────────────────────
# Get these from your VPN provider's WireGuard config (ProtonVPN etc.)
WIREGUARD_PRIVATE_KEY=
WIREGUARD_PUBLIC_KEY=
WIREGUARD_ENDPOINT_IP=
WIREGUARD_ADDRESSES=10.2.0.2/32

# ── External APIs ─────────────────────────────────────────────────────────
POLYMARKET_ANALYTICS_API_KEY=
FALCON_API_KEY=
